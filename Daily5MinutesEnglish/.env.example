# API secret — must match js/db-service.js (API_SECRET)
API_SECRET=daily-english-secure-2025-key

# Injected when Upstash Redis is linked via Vercel Marketplace:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Or Vercel Storage KV names:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Or TCP URL from Vercel Redis integration:
# REDIS_URL=
