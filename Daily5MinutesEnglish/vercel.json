{
  "version": 2,
  "installCommand": "npm install --omit=dev",
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api.php", "dest": "/api/db.js" },
    { "src": "/db.json", "dest": "/api/protect-db.js" },
    { "src": "/backups/(.*)", "dest": "/api/protect-db.js" },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
